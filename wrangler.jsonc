{
  // Site statique + une route : /api/signaler (formulaire « Signaler une erreur »).
  // L'adresse de destination n'est pas ici : c'est le secret MAIL_TO, réglé dans Cloudflare.
  "name": "lignages",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "send_email": [{ "name": "MAIL" }],
  "env": {
    "test": {
      "workers_dev": false,
      "preview_urls": false,
      "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
      "send_email": [{ "name": "MAIL" }]
    }
  }
}
